[Unit]
Description=ACP Claw virtual Chrome browser
After=server-chrome-xvfb.service
Requires=server-chrome-xvfb.service
PartOf=server-chrome-xvfb.service

[Service]
Type=simple
Environment=SERVER_CHROME_HOME=/home_ext/quyanyi/server-chrome
WorkingDirectory=/home_ext/quyanyi/acp-claw/tools/server-browser
ExecStart=/home_ext/quyanyi/acp-claw/tools/server-browser/start-chrome.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
