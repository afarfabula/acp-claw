# Fixed Overleaf Community Edition release.
OVERLEAF_VERSION=6.3.1
OVERLEAF_REPOSITORY=docker.1panel.live/sharelatex/sharelatex

# Runtime and persistent data all live outside this Git repository.
OVERLEAF_DATA_ROOT=/home_ext/quyanyi/overleaf-data
OVERLEAF_BIND_ADDRESS=127.0.0.1
OVERLEAF_PORT=51007
OVERLEAF_SECURE_COOKIE=true

# Public address used by Overleaf for links, cookies and websockets.
OVERLEAF_SITE_URL=https://overleaf.afarfabula.org
OVERLEAF_APP_NAME=Overleaf
OVERLEAF_NAV_TITLE=Overleaf
OVERLEAF_ADMIN_EMAIL=quyanyi@example.com

# Generate both with: openssl rand -hex 32
OVERLEAF_SESSION_SECRET=replace-with-a-random-hex-secret
OVERLEAF_INVITE_TOKEN_SECRET=replace-with-another-random-hex-secret

# Rootless Enroot runtime.
ENROOT_VERSION=4.2.1
ENROOT_PREFIX=/home/quyanyi/.local/opt/enroot-4.2.1
ENROOT_DEPS_PATH=/home/quyanyi/.local/opt/enroot-deps
